{
    "Name": "Nighteyes.TF2VRBetterBindings",
    "Description": "Extra SteamVR actions for Titanfall 2 VR (Reload Grab, Crouch, Tactical Ability). Reports menu and start-screen state to the TF2VR Better Bindings OpenXR layer.",
    "Version": "@PROJECT_VERSION@",
    "LoadPriority": 3,
    "Dependencies": {
        "TF2VR_COCKPIT": "Titanfall2VR.Cockpit"
    },
    "ConVars": [
        { "Name": "tf2vrbb_menu_active", "DefaultValue": "1" },
        { "Name": "tf2vrbb_titan", "DefaultValue": "0" }
    ],
    "Scripts": [
        {
            "Path": "tf2vrbb_menu_state.nut",
            "RunOn": "UI",
            "UICallback": { "After": "TF2VRBB_MenuStateInit" }
        },
        {
            "Path": "tf2vrbb_titan_state.nut",
            "RunOn": "CLIENT",
            "ClientCallback": { "After": "TF2VRBB_TitanStateInit" }
        }
    ]
}
