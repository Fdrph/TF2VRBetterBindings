{
    "Name": "Nighteyes.TF2VRBetterBindings",
    "Description": "Extra SteamVR actions for Titanfall 2 VR (Toggle Grip, Crouch, Tactical Ability, weapon switching). Reports menu, start-screen, weapon and magazine state to the TF2VR Better Bindings OpenXR layer.",
    "Version": "@PROJECT_VERSION@",
    "LoadPriority": 3,
    "Dependencies": {
        "TF2VR_COCKPIT": "Titanfall2VR.Cockpit",
        "TF2VR_MULTIPLAYER": "Titanfall2VR.Multiplayer"
    },
    "ConVars": [
        { "Name": "tf2vrbb_menu_active", "DefaultValue": "1" },
        { "Name": "tf2vrbb_startup_phase", "DefaultValue": "-1" },
        { "Name": "tf2vrbb_active_slot", "DefaultValue": "-2" },
        { "Name": "tf2vrbb_trigger_kind", "DefaultValue": "0" },
        { "Name": "tf2vrbb_clip", "DefaultValue": "-1" },
        { "Name": "tf2vrbb_multiplayer", "DefaultValue": "0" }
    ],
    "Scripts": [
        {
            "Path": "tf2vrbb_menu_state.nut",
            "RunOn": "UI",
            "UICallback": { "After": "TF2VRBB_MenuStateInit" }
        },
        {
            "Path": "tf2vrbb_weapon_state.nut",
            "RunOn": "CLIENT",
            "ClientCallback": { "After": "TF2VRBB_WeaponStateInit" }
        }
    ]
}
